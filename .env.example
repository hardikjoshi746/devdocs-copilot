# Copy to .env and fill in values — never commit .env

# Phase 0 — GitHub API (needed for issue fetching)
# Generate at: https://github.com/settings/tokens → Fine-grained token → read:issues
GITHUB_TOKEN=

# Phase 2 — Embeddings
OPENAI_API_KEY=

# Phase 3+ — LLM generation + retrieval evaluation
ANTHROPIC_API_KEY=

# Phase 5 — Observability backend
# "phoenix" locally, "xray" on AWS
TRACER_BACKEND=phoenix

# Redis — answer cache (LRU eviction, flushed automatically on re-ingestion)
REDIS_URL=redis://localhost:6379
# Configure Redis memory limit + LRU policy in redis.conf or at startup:
#   redis-cli config set maxmemory 256mb
#   redis-cli config set maxmemory-policy allkeys-lru

# Repos to ingest — JSON array, add more entries for additional repos
# src_dirs: subdirectories to walk for source files (empty = entire repo)
REPOS=[{"slug": "owner/repo", "name": "repo", "src_dirs": ["backend", "frontend/src"]}]

# Phase 11+ — AWS (only needed for production deployment)
AWS_REGION=us-east-1
S3_BUCKET=
# Credentials: use IAM role on EC2 — never put AWS keys here